# Cacty Voice — Environment Variables
# Copy this file to .env and fill in your keys.

# --- Voice pipeline (required) ---------------------------------------------

# NVIDIA Nemotron Speech Streaming ASR (STT) — WebSocket URL
NVIDIA_ASR_URL=ws://44.241.251.184:8080

# NVIDIA Nemotron LLM (vLLM, OpenAI-compatible /v1)
NEMOTRON_LLM_URL=http://nemotron-fleet-alb-1322439314.us-west-2.elb.amazonaws.com/v1
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super
# Keep OFF for voice latency unless the vLLM server has a reasoning parser.
NEMOTRON_ENABLE_THINKING=false

# Gradium (TTS)
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# --- Cacty bridge (required) -----------------------------------------------
# Where the Cacty app's loopback bridge listens. Must be on THIS Mac (Cacty
# automates the local machine). Default port 8765; if you override it, launch
# Cacty with a matching CACTY_BRIDGE_PORT.
CACTY_URL=http://127.0.0.1:8765

# --- Local dev -------------------------------------------------------------
# Set to "local" to disable the Krisp noise filter (only on Pipecat Cloud).
ENV=local

# --- Twilio (only needed for real phone calls) -----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# NOTE: Cacty itself needs its OWN Google Gemini key, passed when you launch
# the Cacty app — NOT here. Launch via launchd (open), not the bare binary:
#   launchctl setenv GEMINI_API_KEY sk-... && open cacty/build/Cacty.app
# See CACTY_VOICE.md for why (TCC + ad-hoc signing).
